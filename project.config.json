    "license": "MIT",
    "keywords": [
      "counter",
      "count-up",
      "countup",
      "number",
      "animation",
      "scroll",
      "intersection-observer",
      "intl"
    ]
  },
  "site": {
    "url": "https://samline.github.io/counter/",
    "repository": "https://github.com/samline/counter",
    "namespace": "samline-counter",
    "template": false,
    "credit": "samline"
  },
  "theme": {
    "accentLight": "#bf4532",
    "accentDark": "#ea6a55"
  },
  "delivery": {
    "cdnScript": "https://cdn.jsdelivr.net/npm/@samline/counter@1.0.0/dist/browser/counter.global.js",
    "cdnStylesheet": null
  },
  "dev": {
    "landingPort": 4430,
    "docsPort": 4431,
    "testPort": 4438
  }
}

---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="formats" data-preview="formats">
    <dl lang="en">
      <div><dt>As written: no separators</dt><dd><span data-counter>8000</span></dd></div>
      <div><dt>As written: separators and decimals</dt><dd><span data-counter>8,000.45</span></dd></div>
      <div><dt>grouping="true"</dt><dd><span data-counter data-counter-grouping="true">8000</span></dd></div>
      <div><dt>grouping="true" keeps the $</dt><dd><span data-counter data-counter-grouping="true">$8000</span></dd></div>
      <div><dt>grouping="true" decimals="2"</dt><dd><span data-counter data-counter-grouping="true" data-counter-decimals="2">8000</span></dd></div>
      <div><dt>grouping="false"</dt><dd><span data-counter data-counter-grouping="false">8,000</span></dd></div>
      <div><dt>grouping="true" lang="de"</dt><dd><span data-counter data-counter-grouping="true" lang="de">8000,5</span></dd></div>
      <div><dt>format: compact, suffix kept</dt><dd><span data-compact>8000 visits</span></dd></div>
      <div><dt>format: currency + grouping: true</dt><dd><span data-usd>8000</span></dd></div>
    </dl>
    <button type="button" class="again" data-again>Count again</button>
  </div>
</div>

<style>
  .formats {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  dl div {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
  }
  dt {
    font: 0.8125rem/1.4 var(--font-mono);
    color: var(--color-text-subtle);
  }
  dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .again {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, counter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('formats', root => {
    const cleanups = [
      autoCounter({ scope: root }),
      counter(root.querySelector('[data-compact]'), { format: { notation: 'compact' } }),
      counter(root.querySelector('[data-usd]'), {
        grouping: true,
        format: { style: 'currency', currency: 'USD' },
      }),
    ]
    root.querySelector('[data-again]')!.addEventListener('click', () =>
      root.querySelectorAll('dd span').forEach(number => getCounter(number)?.start())
    )
    return cleanups
  })
</script>

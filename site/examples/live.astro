---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="live" data-preview="live" lang="en">
    <section>
      <h3>Price</h3>
      <p class="big"><span data-role="price" data-counter="12">$12</span> per month</p>
      <div class="actions" role="group" aria-label="Billing">
        <button type="button" data-price="12" aria-pressed="true">Monthly</button>
        <button type="button" data-price="10" aria-pressed="false">Yearly</button>
      </div>
    </section>
    <section>
      <h3>Cart</h3>
      <p class="big"><span data-role="items" data-counter="1">1</span> items</p>
      <div class="actions">
        <button type="button" data-role="remove" aria-label="Remove an item">-</button>
        <button type="button" data-role="add" aria-label="Add an item">+</button>
      </div>
    </section>
    <section>
      <h3>Visitors right now</h3>
      <p class="big"><span data-role="visitors" data-counter="1280" data-counter-duration="800">1,280</span></p>
      <p class="note">A new value arrives every two seconds.</p>
    </section>
  </div>
</div>

<style>
  .live {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
  h3 {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  .big {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  .actions button {
    min-width: 2.5rem;
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .actions button[aria-pressed='true'] {
    border-color: var(--color-text);
    font-weight: 600;
  }
  .note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
</style>

<script>
  import { autoCounter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('live', root => {
    const auto = autoCounter({ scope: root })
    const find = (role: string) => root.querySelector<HTMLElement>(`[data-role="${role}"]`)!

    const price = getCounter(find('price'))!
    const billing = root.querySelectorAll<HTMLButtonElement>('[data-price]')
    billing.forEach(button =>
      button.addEventListener('click', () => {
        billing.forEach(other => other.setAttribute('aria-pressed', String(other === button)))
        price.set(Number(button.dataset.price))
      })
    )

    const items = getCounter(find('items'))!
    find('add').addEventListener('click', () => items.increment())
    find('remove').addEventListener('click', () => {
      if (items.getSnapshot()[0]!.to > 0) items.decrement()
    })

    const visitors = find('visitors')
    const timer = setInterval(() => {
      const next = Number(visitors.dataset.counter) + Math.round(Math.random() * 60 - 25)
      visitors.dataset.counter = String(Math.max(0, next))
    }, 2000)

    return [auto, () => clearInterval(timer)]
  })
</script>

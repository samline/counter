---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="named-example" data-preview="named" lang="en">
    <dl class="named">
      <div>
        <dt>Downloads</dt>
        <dd><span data-counter="1500000" data-counter-format="compact">1.5M</span></dd>
      </div>
      <div>
        <dt>Satisfied</dt>
        <dd><span data-counter="0.86" data-counter-format="percent">86%</span></dd>
      </div>
      <div lang="de">
        <dt>Umsatz</dt>
        <dd>
          <span data-counter="1234.50" data-counter-format="currency:EUR">1.234,50 €</span>
        </dd>
      </div>
      <div>
        <dt>Top speed</dt>
        <dd>
          <span data-counter="120" data-counter-format="unit:kilometer-per-hour">120 km/h</span>
        </dd>
      </div>
      <div>
        <dt>Stored</dt>
        <dd><span data-counter="2400000000" data-counter-format="bytes">2.4 GB</span></dd>
      </div>
    </dl>
    <p class="actions">
      <button type="button" class="action" data-again>Count again</button>
    </p>
  </div>
</div>

<style>
  .named-example {
    display: grid;
    gap: 1rem;
  }
  .named {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin: 0;
  }
  dt {
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  dd {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    margin: 0;
  }
  .action {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, defineFormat, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  defineFormat('bytes', value => {
    let unit = 0
    while (value >= 1000 && unit < units.length - 1) {
      value /= 1000
      unit++
    }
    return `${value.toFixed(unit ? 1 : 0)} ${units[unit]}`
  })

  preview('named', root => {
    const controller = autoCounter({ scope: root })
    root
      .querySelector('[data-again]')!
      .addEventListener('click', () =>
        root.querySelectorAll('.named [data-counter]').forEach(number => getCounter(number)?.start())
      )
    return controller
  })
</script>

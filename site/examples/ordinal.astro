---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="ordinal-example" data-preview="ordinal">
    <ul class="ranks">
      <li lang="en">Ranked <span data-counter data-counter-from="340">21st</span> of 340 teams</li>
      <li lang="en">Our <span data-counter data-counter-from="1">103rd</span> release</li>
      <li lang="fr"><span data-counter data-counter-from="1">2e</span> édition</li>
      <li lang="es">
        <span data-counter="5" data-counter-from="1" data-counter-ordinal="other=.ª">5.ª</span> temporada
      </li>
    </ul>
    <p class="actions">
      <button type="button" class="action" data-again>Count again</button>
    </p>
  </div>
</div>

<style>
  .ordinal-example {
    display: grid;
    gap: 1rem;
  }
  .ranks {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.5rem;
  }
  .ranks span {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    margin: 0;
  }
  .action {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('ordinal', root => {
    const controller = autoCounter({ scope: root })
    root
      .querySelector('[data-again]')!
      .addEventListener('click', () =>
        root.querySelectorAll('.ranks [data-counter]').forEach(number => getCounter(number)?.start())
      )
    return controller
  })
</script>

---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="progress-example">
    <div class="meters" data-preview="progress" lang="en">
      <section>
        <h3>Progress bar</h3>
        <p class="big"><span data-counter="72" data-counter-output="#preview-skill">72</span>%</p>
        <progress id="preview-skill" max="100" value="72">72%</progress>
      </section>
      <section>
        <h3>Meter</h3>
        <p class="big"><span data-counter="38.5" data-counter-output="#preview-storage">38.5</span> GB of 50 GB</p>
        <meter id="preview-storage" min="0" max="50" high="45" value="38.5">38.5 GB</meter>
      </section>
      <section>
        <h3>Ring from --counter-value</h3>
        <div class="ring">
          <span class="big" data-counter data-counter-css-vars=".ring">86%</span>
        </div>
      </section>
      <section>
        <h3>Goal from --counter-progress</h3>
        <div class="track"><div class="fill"></div></div>
        <p class="big"><span data-counter="2000" data-counter-grouping="true" data-counter-css-vars=".meters section">2000</span> steps</p>
      </section>
    </div>
    <button type="button" class="again" data-again>Count again</button>
  </div>
</div>

<style>
  .progress-example {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .meters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
    width: 100%;
  }
  h3 {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  .big {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  progress,
  meter {
    width: 100%;
    accent-color: var(--color-accent);
  }
  .ring {
    --counter-value: 86;
    display: grid;
    place-items: center;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--color-bg) 78%, transparent 80%),
      conic-gradient(var(--color-accent) calc(var(--counter-value) * 3.6deg), var(--color-border) 0);
  }
  .ring .big {
    margin: 0;
  }
  section {
    --counter-progress: 1;
  }
  .track {
    height: 0.75rem;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-border);
  }
  .fill {
    width: calc(var(--counter-progress) * 100%);
    height: 100%;
    background: var(--color-accent);
  }
  .again {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('progress', root => {
    const controller = autoCounter({ scope: root })
    root.querySelector('[data-again]')!.addEventListener('click', () =>
      root.querySelectorAll('[data-counter]').forEach(number => getCounter(number)?.start())
    )
    return controller
  })
</script>

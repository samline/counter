---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="roll-example" data-preview="roll" lang="en">
    <dl class="board">
      <div>
        <dt>Revenue</dt>
        <dd><span data-counter="1250000" data-counter-roll>$1,250,000</span></dd>
      </div>
      <div>
        <dt>Uptime</dt>
        <dd><span data-counter="99.95" data-counter-roll>99.95%</span></dd>
      </div>
      <div lang="ar" dir="rtl">
        <dt>الزوار</dt>
        <dd><span data-counter data-counter-roll>١٬٢٣٤</span></dd>
      </div>
    </dl>
    <p class="score">
      <span
        data-score
        data-counter="120"
        data-counter-roll
        data-counter-steady
        data-counter-duration="800">120</span
      >{' '}points
    </p>
    <p class="actions">
      <button type="button" class="action" data-add>Add 75</button>
      <button type="button" class="action" data-take>Take 40</button>
      <button type="button" class="action" data-again>Count again</button>
    </p>
  </div>
</div>

<style>
  .roll-example {
    display: grid;
    gap: 1rem;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
    margin: 0;
  }
  dt {
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }
  .score {
    margin: 0;
    font-size: 1.5rem;
  }
  .score span {
    font-weight: 700;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .action {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('roll', root => {
    const controller = autoCounter({ scope: root })
    const score = getCounter(root.querySelector('[data-score]'))
    root.querySelector('[data-add]')!.addEventListener('click', () => score?.increment(75))
    root.querySelector('[data-take]')!.addEventListener('click', () => score?.decrement(40))
    root
      .querySelector('[data-again]')!
      .addEventListener('click', () =>
        root
          .querySelectorAll('.board [data-counter]')
          .forEach(number => getCounter(number)?.start())
      )
    return controller
  })
</script>

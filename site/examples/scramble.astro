---
import './_shared.css'
---

<div class="preview counter-example">
  <div class="scramble-example" data-preview="scramble" lang="en">
    <dl class="codes">
      <div>
        <dt>Order</dt>
        <dd>
          <span
            data-counter="20481736"
            data-counter-grouping="false"
            data-counter-scramble
            data-counter-steady>#20481736</span
          >
        </dd>
      </div>
      <div>
        <dt>Revenue</dt>
        <dd>
          <span data-counter="1250000" data-counter-scramble data-counter-steady>$1,250,000</span>
        </dd>
      </div>
      <div>
        <dt>Flight time</dt>
        <dd>
          <time data-counter data-counter-as="time" data-counter-scramble data-counter-steady
            >02:45:30</time
          >
        </dd>
      </div>
    </dl>
    <p class="actions">
      <button type="button" class="action" data-again>Decode again</button>
    </p>
  </div>
</div>

<style>
  .scramble-example {
    display: grid;
    gap: 1rem;
  }
  .codes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
    margin: 0;
  }
  dt {
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }
  .actions {
    margin: 0;
  }
  .action {
    padding: 0.375rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
</style>

<script>
  import { autoCounter, getCounter } from '@samline/counter'
  import { preview } from '../../shared/lib/preview'

  preview('scramble', root => {
    const controller = autoCounter({ scope: root })
    root
      .querySelector('[data-again]')!
      .addEventListener('click', () =>
        root.querySelectorAll('.codes [data-counter]').forEach(number => getCounter(number)?.start())
      )
    return controller
  })
</script>
